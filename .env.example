# Environment variables read by the pipeline. Export them in your shell (the code reads
# environment variables only; it does not load .env files). All values are optional.

# Data root for every read and write. Must be an absolute path.
# Default when unset: <repository>/data (git-ignored).
# Keep licensed or restricted inputs outside the repository by pointing this elsewhere.
BCM_DATA_DIR=/absolute/path/to/your/data-root

# Restricted country/region reference tables (only needed for real-data runs).
# Default: $BCM_DATA_DIR/restricted/admin_reference/<file>.csv
# BCM_ADMIN_REFERENCE_DIR=/absolute/path/to/admin_reference
# BCM_COUNTRY_CODE_MAPPING=/absolute/path/to/country_code_mapping.csv
# BCM_GROUP_DEFINITIONS=/absolute/path/to/group_definitions.csv
# BCM_GROUP_MEMBERSHIP=/absolute/path/to/group_membership.csv
